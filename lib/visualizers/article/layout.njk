---
layout: layouts/base.njk
---
{% set typeData = bloobObjects[bloob_object] if bloob_object and bloobObjects else null %}
{# .article-page--index: an index page (a folder's, by default). Its frame is the
   wide edge, so the header lines up with a wide shape below it (styles.css →
   "Folder-index frame"). Any article page can opt in or out with a tri-state
   `index_frame: on|off` (shapes.md convention #5); the shared tag pages opt in.
   `"" ~ value` (not `| string`) so an empty YAML value can't throw. #}
{% set _indexFrame = ("" ~ shape_settings.index_frame) | lower %}
{% set isIndex = true if _indexFrame in ["true", "on"] else (false if _indexFrame in ["false", "off"] else (is_folder == true)) %}
<article class="article-page{% if isIndex %} article-page--index{% endif %}" {% if _bloob_unlisted %}data-pagefind-ignore{% else %}data-pagefind-body{% endif %}>
  <header class="article-header">
    {# Optional profile fields (a firm, a person, a product): `logo` arrives as a site
       URL (preprocess resolves the vault path / [[wiki]] form); `website` is linked
       only when it is an http(s) address. Both render nothing when absent. #}
    {% if logo %}<img class="article-logo no-pswp" src="{{ logo }}" alt="{{ title }}">{% endif %}
    {% if typeData and typeData.display_name %}<p class="article-type">{{ typeData.display_name }}</p>{% endif %}
    <h1 class="article-title">{{ (title_md if title_md else title) | mdinline | safe }}</h1>
    {% if subtitle %}<p class="article-subtitle" data-pagefind-meta="subtitle[content]" content="{{ subtitle }}">{{ subtitle | mdinline | safe }}</p>{% endif %}
    {% if typeData and typeData.banner_text %}<p class="article-banner-text">{{ typeData.banner_text }}</p>{% endif %}
    {% if website and r/^https?:\/\//i.test(website) %}<p class="article-website"><a href="{{ website }}" target="_blank" rel="noopener">{{ website | replace(r/^https?:\/\/(www\.)?/i, "") | replace(r/\/$/, "") }}</a></p>{% endif %}
    {% if author %}<p class="article-author">By {{ author }}</p>{% endif %}
    {% if byline %}<p class="article-byline">{{ byline }}</p>{% endif %}

    {#
      Date pills. Two authoring conventions, both supported (see
      scripts/utils/date-field.js):
        comma form    date_created: 2024-11-07, Published on
        separate key  date_created: 2024-11-07  +  date_created_text: Published on
      `date_updated:` may be a list — the LATEST entry wins, regardless of order.
      The updated pill is suppressed when it would duplicate the created pill.

      Shown on reading articles, HIDDEN on index pages (isIndex above) by default — an
      index is a room's front door, not a dated piece of writing. Either way a
      ::: settings block decides, tri-state (shapes.md convention #5):
        show_date_created: true | on | false | off
        show_date_updated: true | on | false | off
      `"" ~ value` (not `| string`) so an empty YAML value can't throw.
    #}
    {% set dcFmt = date_created | dateValue | dateFormat %}
    {% set duFmt = date_updated | dateValue | dateFormat %}
    {% set sdc = ("" ~ shape_settings.show_date_created) | lower %}
    {% set sdu = ("" ~ shape_settings.show_date_updated) | lower %}
    {% set showCreated = true if sdc in ["true", "on"] else (false if sdc in ["false", "off"] else not isIndex) %}
    {% set showUpdated = true if sdu in ["true", "on"] else (false if sdu in ["false", "off"] else not isIndex) %}

    {% if dcFmt and showCreated %}
    <p class="article-date" data-pagefind-ignore>{{ date_created | dateLabel(date_created_text, "Written on") }} {{ dcFmt }}</p>
    {% endif %}

    {% if duFmt and duFmt != dcFmt and showUpdated %}
    <p class="article-date article-date--updated" data-pagefind-ignore>{{ date_updated | dateLabel(date_updated_text, "Updated on") }} {{ duFmt }}</p>
    {% endif %}

    {% if shape_settings.share_bar !== false %}
      {% include "partials/share-bar.njk" %}
    {% endif %}

    {# Visitor count sits with the other metadata pills. Self-guarding: renders nothing
       unless the vault opted in AND the GoatCounter site allows the counter. #}
    {% include "partials/visitor-count.njk" %}
  </header>

  {% if slug %}
  <span aria-hidden="true" style="position:absolute;clip:rect(0,0,0,0)">ID: {{ slug }}{% if is_folder %}/{% endif %}</span>
  {% if slug_spaced and slug_spaced != slug %}<span aria-hidden="true" style="position:absolute;clip:rect(0,0,0,0)">{{ slug_spaced }}</span>{% endif %}
  {% endif %}

  <div class="article-body">
    {{ content | safe }}
  </div>
</article>

{# The article shape is commentable — it places the comment thread right after the body.
   Placement is the shape's choice; see docs/architecture/shapes.md "Comments — a shape behavior". #}
{% include "partials/comments.njk" %}
