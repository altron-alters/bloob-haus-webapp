<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {% set seo_home_uses_page_title = true %}
    {# Title, description, canonical, robots, Open Graph, Twitter: shared, themes/_base/partials/seo-meta.njk #}
    {% include "partials/seo-meta.njk" %}

    <meta name="bloob-page-id" content="{{ bloobPageId }}" />
    {% if redirect %}
    <!-- Redirect — set via `redirect:` frontmatter in the content vault -->
    <meta http-equiv="refresh" content="0; url={{ redirect }}" />
    <script>window.location.replace("{{ redirect }}");</script>
    {% endif %}

    <!-- RSS Feed -->
    <link rel="alternate" type="application/atom+xml" title="{{ site.title }}" href="{{ "/feed.xml" | url }}" />

    <!-- Favicon -->
    <link rel="icon" type="image/png" href="{{ "/favicon.png" | url }}" />
    <link rel="apple-touch-icon" href="{{ "/apple-touch-icon.png" | url }}" />

    <!-- Satoshi (primary theme font, self-hosted via Fontshare CDN) -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link
        href="https://api.fontshare.com/v2/css?f[]=satoshi@400,500,700&display=optional"
        rel="stylesheet"
    />

    <!-- Stylesheets: carousel → theme → tokens/overrides -->
    <link rel="stylesheet" href="{{ "/assets/css/base.css" | url }}" />
    <link rel="stylesheet" href="{{ "/assets/css/swiper-bundle.min.css" | url }}" />
    <link rel="stylesheet" href="{{ "/assets/css/theme.min.css" | url }}" />
    <link rel="stylesheet" href="{{ "/assets/css/main.css" | url }}" />
    {% if site.features.image_zoom != false %}
    <!-- PhotoSwipe lightbox -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/photoswipe@5.4.4/dist/photoswipe.css" />
    {% endif %}

    <!-- Visualizer stylesheets (auto-generated from lib/visualizers/) -->
    <!--bloob:visualizer-css-->
    <!-- Theme-specific visualizer overrides (themes/alter-engineers/assets/css/visualizers/*.css) -->
    {% for name in themeVisualizerCss %}
    <link rel="stylesheet" href="{{ ("/assets/css/theme-visualizers/" + name + ".css") | url }}" />
    {% endfor %}

    {% include "partials/site-snippets-head.njk" %}
</head>
